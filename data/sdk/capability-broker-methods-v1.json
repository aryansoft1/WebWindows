          "type": "boolean"
        },
        "present": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "level": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "charging": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "connected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "source": {
          "enum": [
            "browser",
            "runtime",
            "unsupported"
          ]
