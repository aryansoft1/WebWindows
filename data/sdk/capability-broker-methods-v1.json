              "type": "boolean"
            },
            "videoDecoder": {
              "type": "boolean"
            },
            "audioEncoder": {
              "type": "boolean"
            },
            "audioDecoder": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "mediaRecorder": {
          "type": "object",
          "required": [
            "videoMp4",
            "webmVp9",
            "webmVp8"
          ],
          "properties": {
            "videoMp4": {
              "type": "boolean"
            },
            "webmVp9": {
              "type": "boolean"
            },
            "webmVp8": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "offlineAudioContext": {
          "type": "boolean"
        },
        "codecs": {
          "type": "object",
          "required": [
            "decode"
          ],
          "properties": {
            "decode": {
              "type": "object",
              "properties": {
                "avc1": {
                  "type": "boolean"
                },
                "hevc": {
                  "type": "boolean"
                },
                "vp8": {
                  "type": "boolean"
                },
                "vp9": {
                  "type": "boolean"
                },
                "av1": {
                  "type": "boolean"
