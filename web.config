<?xml version="1.0" encoding="utf-8"?>
<!-- Root configuration required by the hosting control panel. Updated for Mail Center deployment. -->
<configuration>
  <appSettings>
    <!-- Set these on the hosting server. Never commit actual credentials. -->
    <add key="MailCenterConnectionString" value="" />
    <add key="MailCenterEncryptionKeyBase64" value="J2qTaM0ksrTggshX2z4y58E1PEJYhaBOK/RZ+XRMcE4=" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.7" />
    <httpRuntime targetFramework="4.7" maxRequestLength="10240" executionTimeout="120" />
    <!-- Keep detailed errors enabled during the current deployment verification. -->
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <!-- Preserve the existing Classic ASP application behavior. -->
    <modules runAllManagedModulesForAllRequests="false" />
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />
  </system.webServer>
  <location path="SystemManager">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <add name="Content-Security-Policy" value="frame-ancestors 'self'; object-src 'none'; base-uri 'self'" />
          <add name="X-Frame-Options" value="SAMEORIGIN" />
          <add name="Referrer-Policy" value="same-origin" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
