    "publisherId": "opaque-server-identity",
    "version": "manifest-version-string",
    "manifestVersion": "positive-integer",
    "sdkVersion": "string-or-null",
    "packageSha256": "lowercase-sha256",
    "sourceManifestSha256": "lowercase-sha256",
    "publishedReleaseId": "opaque-server-identity",
    "catalogRevisionId": "opaque-server-identity",
    "reviewDecisionId": "opaque-server-identity",
    "reviewPolicyVersion": "positive-integer"
  },
  "authorities": {
    "appId": "verified-zip-root-source-manifest",
    "version": "verified-zip-root-source-manifest",
    "manifestVersion": "verified-zip-root-source-manifest",
    "sdkVersion": "verified-zip-root-source-manifest",
    "publisherId": "developer-account-and-app-ownership-record",
    "packageSha256": "server-upload-digest-and-runtime-verification",
    "sourceManifestSha256": "server-validator-canonical-manifest-digest",
    "publishedReleaseId": "publication-service",
    "catalogRevisionId": "published-catalog",
    "reviewDecisionId": "review-service",
    "reviewPolicyVersion": "review-service"
