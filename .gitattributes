# Deployment artifacts and contract sources use checkout-stable LF bytes so SHA-256 evidence is portable.
*.asp text eol=lf
*.config text eol=lf
*.css text eol=lf
*.d.ts text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mjs text eol=lf
*.ps1 text eol=lf
*.sql text eol=lf
*.vue text eol=lf
*.xml text eol=lf
*.exe binary
*.zip binary
