  "packageTrustChain": [
    "uploaded-zip",
    "server-sha256",
    "server-safe-extraction",
    "zip-root-source-manifest-validation",
    "server-validation-report",
    "package-bound-review-decision",
    "approved-published-release",
    "catalog-release-reference",
    "runtime-download",
    "runtime-sha256-verification",
    "published-app-identity",
    "trusted-production-broker-context"
  ],
  "fatalIntegrityFailures": [
    "package-hash-mismatch",
    "version-mismatch",
    "manifest-mismatch",
    "release-identity-mismatch",
    "review-package-binding-mismatch"
