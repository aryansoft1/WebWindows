node_modules/
dist-weather/

# Local server-side secrets
.env
.env.*
!.env.example
cloud/desktalk/chatproxy.config.asp
!cloud/desktalk/chatproxy.config.example.asp
# 代理层的真实密钥配置：只提交 .example 模板
api/*.config.asp
!api/*.config.example.asp

# Local workspaces, caches, and logs
tmp/
outputs/
.cache/
.codex/
.agents/
logs/
*.log
*.tmp

# Generated build output (existing tracked dist files remain tracked)
build/
**/bin/
**/obj/
*.dll
*.pdb

# Local archives, backups, patches, and rendered media
*.zip
*.bak
*.backup
*.patch
patch.diff
*.mp4
*.mov
*.webm

# Playwright
test-results/
playwright-report/
blob-report/

# deploy-ftp.ps1 writes its rule-5 production backups here; they are local evidence,
# never deployment source, and leaving them untracked-but-visible fails preflight.
deploy/backups/

# Same for the other backup folder a deployment session may create, and for the one-off
# upload helpers (deploy/t041-upload.ps1 and friends) that sessions leave in deploy/.
.deployment-backups/
deploy/t*-*.ps1
